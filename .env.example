# mock = aucune création Docker réelle
# real = autorise docker compose up/down depuis l'interface
APPBOX_MODE=mock

# Heartbeat receive-time timeout (seconds, minimum 30)
APPBOX_AGENT_ONLINE_SECONDS=180

# Control Plane: maximum wait before an AppBox command must be claimed (minimum 5 s).
APPBOX_AGENT_CLAIM_TIMEOUT_SECONDS=60
